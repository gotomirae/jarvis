# JARVIS 환경변수 (PRD 부록 C). 값은 .env.local 에만 넣는다 — .env* 커밋 금지(공개 저장소).
# lib/env.ts 에서만 읽으며 모든 값은 trim 된다. 비밀에 NEXT_PUBLIC_ 접두사 금지.

# ── JARVIS Supabase (D5 A안: 새 프로젝트 jarvis, 서울) — Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── 대시보드
JARVIS_URL=                      # 배포 후 Vercel URL (links.yaml ${JARVIS_URL} 치환)
ALLOWED_EMAIL=                   # 매직링크 허용 이메일 1개
JARVIS_PUBLIC_TOKEN=             # /api/public/* X-Jarvis-Token

# ── 텔레그램 @Tonny_JARVIS_bot 전용 (다른 봇 토큰 금지)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ── GitHub
GITHUB_REPO=gotomirae/jarvis
GITHUB_DISPATCH_TOKEN=           # 이 저장소 Actions RW (pg_cron Vault 에도 저장)
GITHUB_READ_TOKEN=               # 6개 저장소 Actions 읽기(/health)

# ── LLM (주간 메모 서술 전용. M3 ②는 LLM·유료 API 미사용)
ANTHROPIC_API_KEY=
MEMO_MODEL=claude-sonnet-5
MONTHLY_LLM_CAP_USD=5

# ── 노션 (FlyWheel 읽기·인박스, 주간 메모)
NOTION_API_KEY=
NOTION_IDEA_DB_ID=
NOTION_WEEKLY_PARENT_PAGE_ID=

# ── 연계 프로젝트 (읽기 전용 anon 키만. service 키 금지)
HEIMDALLR_SUPABASE_URL=
HEIMDALLR_ANON_KEY=
HERMES_SUPABASE_URL=
HERMES_ANON_KEY=
SAGE_SUPABASE_URL=
SAGE_READ_KEY=
SNOWBALL_SUPABASE_URL=
SNOWBALL_ANON_KEY=
SNOWBALL_JARVIS_TOKEN=
